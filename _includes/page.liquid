---
title: Page template
---
<!DOCTYPE html>
<html lang="is">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title | i18n }} | Studio Kría</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <script data-goatcounter="https://studiokria.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  <script src="/js/main.js" type="module"></script>
</head>
<body>
  <div class="wrap">
    <header>
      <a href="{{ '/' | locale_url }}" class="logo-link">
        {% if wordmark == 'solid' %}
        <h1 class="wordmark">
          <svg viewBox="0 0 1180 230" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Studio Kría">
            <text x="0" y="190" font-family="Inter, sans-serif" font-weight="900" font-size="210" textLength="1180" lengthAdjust="spacingAndGlyphs" fill="#f3ede1">Studio Kría</text>
          </svg>
        </h1>
        {% else %}
        <h1 class="wordmark wordmark--ghost">
          <svg viewBox="0 0 1180 230" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Studio Kría">
            <defs>
              <filter id="ghostOutline" x="-10%" y="-60%" width="120%" height="220%">
                <feMorphology in="SourceAlpha" operator="dilate" radius="3" result="dilated"/>
                <feComposite in="dilated" in2="SourceAlpha" operator="out" result="ring"/>
                <feGaussianBlur in="ring" stdDeviation="0.9" result="softRing"/>
                <feFlood flood-color="#f3ede1" flood-opacity="0.32" result="color"/>
                <feComposite in="color" in2="softRing" operator="in"/>
              </filter>
            </defs>
            <text x="0" y="190" font-family="Inter, sans-serif" font-weight="900" font-size="210" textLength="1180" lengthAdjust="spacingAndGlyphs" fill="#000" filter="url(#ghostOutline)">Studio Kría</text>
            <text x="0" y="190" font-family="Inter, sans-serif" font-weight="900" font-size="210" textLength="1180" lengthAdjust="spacingAndGlyphs" fill="#f3ede1" class="wordmark-fill-layer">Studio Kría</text>
          </svg>
        </h1>
        {% endif %}
      </a>
      <img class="bird bird--intro" src="/images/bird-orange.svg" alt="Kría bird logo">
      <button class="menu-toggle" id="menuToggle" aria-label="{{ 'open_menu_text' | i18n }}" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </header>

    <nav class="nav-overlay" id="navOverlay">
      <img class="bird-bg" src="/images/bird-orange.svg" alt="">
      <button class="nav-close" id="navClose" aria-label="{{ 'close_menu_text' | i18n }}">
        <span></span><span></span>
      </button>
      {%- for link in navigation -%}
      <a href="{{ link.url | locale_url }}">{{ link.title | i18n }}</a>
      {%- endfor -%}

      {% assign links = page.url | locale_links %}
      {%- for link in links %}
      {%- unless forloop.first %},{% endunless %}
      <a href="{{link.url}}" lang="{{link.lang}}" hreflang="{{link.lang}}">{{link.label}}</a>
      {%- endfor -%}
    </nav>

    {{ content }}

    <hr class="divider" />

    <footer>
      <a href="{{ '/' | locale_url }}" class="foot-brand">
        <img class="bird-mini" src="/images/bird-cream.svg" alt="Kría bird logo">
        <img class="wordmark-mini" src="/images/wordmark.svg" alt="Studio Kría">
      </a>

      <div class="foot-col">
        kt. 0101072020<br>
        VSK 23489456
      </div>

      <div class="foot-col">
        {%- for link in navigation -%}
          {% if link.showInFooter %}
            <a href="{{ link.url | locale_url }}">{{ link.title | i18n }}</a>
          {% endif %}
        {%- endfor -%}
      </div>

      <div class="foot-col">
        <a href="#">Email</a>
        <a href="#">Phone</a>
        <a href="#">Phone</a>
      </div>

      <div class="foot-col">
        <a href="#">Instagram</a>
        <a href="#">TikTok</a>
        <a href="#">YouTube</a>
      </div>
    </footer>
  </div>
</body>
</html>
